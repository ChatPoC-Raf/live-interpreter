{
  "name": "live-interpreter",
  "version": "0.1.0",
  "description": "Konsekutywny tlumacz wystapien na zywo z klonem glosu mowcy (Electron + ElevenLabs)",
  "main": "./out/main/index.js",
  "author": "Rafal Witkowski",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/copy-vad-assets.mjs && electron-vite dev",
    "build": "node scripts/copy-vad-assets.mjs && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run build",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@ricky0123/vad-web": "0.0.30",
    "adm-zip": "^0.5.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.61.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.8"
  }
}
